# Production environment template — copy to .env.production and fill in real values.
# .env.production is gitignored. Never commit actual passwords.
# See docs/PRODUCTION_SECRETS.md for context and K8s Secret examples.

# Auth0
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=your-client-id
VITE_AUTH0_AUDIENCE=https://your-api-audience
VITE_API_URL=https://your-production-domain

AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://your-api-audience

# RabbitMQ — inject per service, each with its own user/password
# party-management
RABBITMQ_PARTY_URL=amqp://tmf_party:<password>@rabbitmq:5672/tmf

# customer-management
RABBITMQ_CUSTOMER_URL=amqp://tmf_customer:<password>@rabbitmq:5672/tmf

# product-catalog-management
RABBITMQ_CATALOG_URL=amqp://tmf_catalog:<password>@rabbitmq:5672/tmf

# qualification
RABBITMQ_QUALIFICATION_URL=amqp://tmf_qualification:<password>@rabbitmq:5672/tmf

# shopping-cart
RABBITMQ_CART_URL=amqp://tmf_cart:<password>@rabbitmq:5672/tmf

# pocv
RABBITMQ_POCV_URL=amqp://tmf_pocv:<password>@rabbitmq:5672/tmf

# bff
RABBITMQ_BFF_URL=amqp://tmf_bff:<password>@rabbitmq:5672/tmf
